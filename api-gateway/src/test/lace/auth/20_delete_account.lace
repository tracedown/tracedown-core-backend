// Delete account validation: wrong password rejected, org owner blocked

// Login
post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "$adminEmail", password: "$adminPassword" })
})
.expect(status: 200)
.store({ "$$token": this.body.token })

// Wrong password → 400 incorrect_password (the same code every re-verified
// action returns; see AuthController.verifyIdentity)
delete("$baseUrl/api/v1/auth/account", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ password: "wrong" })
})
.expect(status: 400)
.assert({ expect: [this.body.error eq "incorrect_password"] })

// Correct password but admin owns organizations with other members → 409,
// naming what is in the way
delete("$baseUrl/api/v1/auth/account", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ password: "$adminPassword" })
})
.expect(status: 409)
.assert({ expect: [this.body.error eq "account_owns_organizations"] })
