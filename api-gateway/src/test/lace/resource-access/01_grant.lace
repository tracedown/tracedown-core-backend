// Grant a user read access to a workspace, list grants, then revoke.

post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "$adminEmail", password: "$adminPassword" })
})
.expect(status: 200)
.store({ "$$token": this.body.token })

post("$baseUrl/api/v1/workspaces", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ name: "GrantWs" })
})
.expect(status: 200)
.store({ "$$wsId": this.body.id })

// Grant the member read (1) access. principalId for a user is the userId.
put("$baseUrl/api/v1/access/workspace/$$wsId", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ principalType: "user", principalId: "$memberId", permissions: 1 })
})
.expect(status: 200)
.assert({ expect: [this.body.ok eq true] })

// The access list returns an array of grant entries: exactly the one just made.
get("$baseUrl/api/v1/access/workspace/$$wsId", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 200, body: schema($resourceAccessListSchema))
.assert({
  expect: [
    count(this.body) eq 1,
    includes("$memberId", this.body)
  ]
})

// Revoke it.
delete("$baseUrl/api/v1/access/workspace/$$wsId/user/$memberId", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 200)
.assert({ expect: [this.body.ok eq true] })

// ...and the list is empty again, which is what "revoked" has to mean.
get("$baseUrl/api/v1/access/workspace/$$wsId", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 200)
.assert({ expect: [count(this.body) eq 0] })
