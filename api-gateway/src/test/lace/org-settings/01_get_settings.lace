// Login as admin
post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "$adminEmail", password: "$adminPassword" })
})
.expect(status: 200)
.store({ "$$token": this.body.token })

// Get org settings
get("$baseUrl/api/v1/org/settings", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 200)
.assert({
  expect: [
    this.body.id eq "$orgId",
    this.body.name eq "Default",
    this.body.dateFormat eq "eu"
  ]
})
