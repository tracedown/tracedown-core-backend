// Service lifecycle: create, script, toggle, version conflict, validation

// Login
post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "$adminEmail", password: "$adminPassword" })
})
.expect(status: 200)
.store({ "$$token": this.body.token })

// Create workspace and project
post("$baseUrl/api/v1/workspaces", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ name: "SvcTestWs" })
})
.expect(status: 200)
.store({ "$$wsId": this.body.id })

post("$baseUrl/api/v1/projects", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ workspaceId: "$$wsId", name: "SvcTestProj" })
})
.expect(status: 200)
.store({ "$$projId": this.body.id })

// ── Create service ──
// Created disabled with empty script, version 1
post("$baseUrl/api/v1/services", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ projectId: "$$projId", name: "Health Check", label: "health" })
})
.expect(status: 200, body: schema($serviceSchema))
.assert({
  expect: [
    this.body.name eq "Health Check",
    this.body.label eq "health",
    this.body.isActive eq false,
    this.body.script eq "",
    this.body.version eq 1,
    this.body.probeMode eq "consecutive",
    this.body.saveResponseBodies eq true
  ]
})
.store({ "$$svcId": this.body.id })

// ── Enable without script fails ──
patch("$baseUrl/api/v1/services/$$svcId/toggle", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ isActive: true })
})
.expect(status: 400)

// ── Set invalid script fails ──
patch("$baseUrl/api/v1/services/$$svcId/script", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ script: "this is not valid lace", version: 1 })
})
.expect(status: 400)

// ── Set valid script with wrong version fails (conflict) ──
patch("$baseUrl/api/v1/services/$$svcId/script", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ script: "get(\"https://example.com\").expect(status: 200)", version: 99 })
})
.expect(status: 409)

// ── Set valid script with correct version succeeds ──
patch("$baseUrl/api/v1/services/$$svcId/script", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ script: "get(\"https://example.com\").expect(status: 200)", version: 1 })
})
.expect(status: 200)
.assert({
  expect: [
    this.body.version eq 2,
    this.body.isActive eq false
  ]
})

// ── Enable now succeeds ──
patch("$baseUrl/api/v1/services/$$svcId/toggle", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ isActive: true })
})
.expect(status: 200)
.assert({ expect: [this.body.isActive eq true] })

// ── Update script again with version 2 ──
patch("$baseUrl/api/v1/services/$$svcId/script", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ script: "get(\"https://example.com/v2\").expect(status: 200)", version: 2 })
})
.expect(status: 200)
.assert({ expect: [this.body.version eq 3] })

// ── Stale version 2 now conflicts ──
patch("$baseUrl/api/v1/services/$$svcId/script", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ script: "get(\"https://example.com/stale\").expect(status: 200)", version: 2 })
})
.expect(status: 409)

// ── Disable ──
patch("$baseUrl/api/v1/services/$$svcId/toggle", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ isActive: false })
})
.expect(status: 200)
.assert({ expect: [this.body.isActive eq false] })

// ── Update config (not script, not toggle) ──
patch("$baseUrl/api/v1/services/$$svcId", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ name: "Health Check v2", schedule: "*/10 * * * *", saveResponseBodies: false })
})
.expect(status: 200)
.assert({
  expect: [
    this.body.name eq "Health Check v2",
    this.body.schedule eq "*/10 * * * *",
    this.body.saveResponseBodies eq false
  ]
})

// ── List services ──
get("$baseUrl/api/v1/services?projectId=$$projId", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 200)
.assert({ expect: [this.body.total eq 1] })

// ── Get single service ──
get("$baseUrl/api/v1/services/$$svcId", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 200)
.assert({ expect: [this.body.name eq "Health Check v2"] })

// ── Delete service ──
delete("$baseUrl/api/v1/services/$$svcId", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 200)

// ── Verify deleted ──
get("$baseUrl/api/v1/services/$$svcId", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 404)
