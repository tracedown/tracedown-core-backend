// API key lifecycle: a user mints a key for themselves, the key authenticates
// the key-authenticated API and nothing else, and it stops when it is revoked.

// Login
post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "$adminEmail", password: "$adminPassword" })
})
.expect(status: 200)
.store({ "$$token": this.body.token })

// Minting asks for the password again: a session alone is refused
post("$baseUrl/api/v1/me/api-keys", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ name: "Test Key", access: "write", password: "not the password" })
})
.expect(status: 400)
.assert({ expect: [this.body.error eq "incorrect_password"] })

// Mint a key — the key itself is in this response and no other
post("$baseUrl/api/v1/me/api-keys", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ name: "Test Key", access: "write", password: "$adminPassword" })
})
.expect(status: 201)
.assert({
  expect: [
    this.body.name eq "Test Key",
    this.body.access eq "write",
    this.body.state eq "active",
    this.body.key neq null
  ]
})
.store({ "$$keyId": this.body.id, "$$key": this.body.key })

// The user's own list shows it, without the key
get("$baseUrl/api/v1/me/api-keys", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 200)
.assert({ expect: [this.body.total eq 1] })

// So does the organization's list
get("$baseUrl/api/v1/api-keys", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 200)
.assert({ expect: [this.body.total eq 1] })

// The key authenticates the key-authenticated API
get("$baseUrl/api/public/v1/key", {
  headers: { Authorization: "Bearer $$key" }
})
.expect(status: 200)
.assert({ expect: [this.body.id eq "$$keyId", this.body.access eq "write"] })

// A key is not a session
get("$baseUrl/api/v1/auth/me", {
  headers: { Authorization: "Bearer $$key" }
})
.expect(status: 401)
.assert({ expect: [this.body.error eq "session_required"] })

// A session is not a key
get("$baseUrl/api/public/v1/key", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 401)
.assert({ expect: [this.body.error eq "invalid_api_key"] })

// Revoke
post("$baseUrl/api/v1/me/api-keys/$$keyId/revoke", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 200)

// A revoked key is refused, and says why
get("$baseUrl/api/public/v1/key", {
  headers: { Authorization: "Bearer $$key" }
})
.expect(status: 401)
.assert({ expect: [this.body.error eq "api_key_revoked"] })

// Delete
delete("$baseUrl/api/v1/me/api-keys/$$keyId", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 200)

get("$baseUrl/api/v1/me/api-keys", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 200)
.assert({ expect: [this.body.total eq 0] })
