// API keys are DEFERRED: no X-Api-Key verifier exists, so a minted key would
// authenticate nothing. The create and list routes are disabled (501) so no one
// is handed a dead credential. This vector pins that deferral — restore the full
// CRUD lifecycle here once a verifier ships and the routes are re-enabled.

// Login
post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "$adminEmail", password: "$adminPassword" })
})
.expect(status: 200)
.store({ "$$token": this.body.token })

// Create is deferred — must report 501, not mint a key
post("$baseUrl/api/v1/api-keys", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ name: "Test Key" })
})
.expect(status: 501)
.assert({ expect: [this.body.error eq "api_keys_deferred"] })

// List is deferred — must report 501 too
get("$baseUrl/api/v1/api-keys", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 501)
.assert({ expect: [this.body.error eq "api_keys_deferred"] })
