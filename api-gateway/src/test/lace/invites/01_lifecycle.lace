// Invite send / list / revoke, plus cooldown and already-member guards.
// The accept flow is not here: the invite token is delivered only by email,
// so it can't be obtained over HTTP (that path stays a Kotlin test).

post("$baseUrl/api/v1/auth/login", {
  body: json({ email: "$adminEmail", password: "$adminPassword" })
})
.expect(status: 200)
.store({ "$$token": this.body.token })

// Send an invite to a new address.
post("$baseUrl/api/v1/invites", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ email: "newcomer@tracedown.dev" })
})
.expect(status: 200)
.assert({ expect: [this.body.ok eq true] })

// It appears in the pending list. `total` counts the whole result set while
// count() sees only this page, so both are checked: a paging bug that returned
// an empty page with a healthy total would otherwise pass.
get("$baseUrl/api/v1/invites", {
  headers: { Authorization: "Bearer $$token" }
})
.expect(status: 200)
.assert({
  expect: [
    this.body.total gt 0,
    count(this.body.items) gt 0,
    includes("newcomer@tracedown.dev", this.body.items)
  ]
})

// Re-inviting the same address immediately is rate-limited.
post("$baseUrl/api/v1/invites", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ email: "newcomer@tracedown.dev" })
})
.expect(status: 429)

// Inviting someone who is already a member is a conflict.
post("$baseUrl/api/v1/invites", {
  headers: { Authorization: "Bearer $$token" },
  body: json({ email: "$memberEmail" })
})
.expect(status: 409)
