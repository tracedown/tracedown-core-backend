# Build from tracedown/ root:
#   docker build -f core/tracedown-core-backend/probe-scheduler/src/test/resources/Dockerfile.agent -t test-agent .
FROM python:3.13-slim
COPY core/tracedown-probe-agent /opt/agent
COPY lace/lacelang-python-validator /opt/lace-validator
COPY lace/lacelang-python-executor /opt/lace-executor
RUN pip install -q /opt/agent /opt/lace-validator /opt/lace-executor
WORKDIR /opt/agent
ENV PYTHONPATH=/opt/agent/src
EXPOSE 8443
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8443"]
