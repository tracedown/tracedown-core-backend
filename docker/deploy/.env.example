# Tracedown deploy configuration.
#
#   cp .env.example .env
#
# Every service reads this file (docker compose injects it wholesale; each
# service picks the variables it knows). Commented lines show the built-in
# default — uncomment to override. The stack runs with DEPLOYMENT_ENV=production
# by default, which REFUSES to start on placeholder secrets: work through the
# REQUIRED section first.

# ── Release versions ─────────────────────────────────────────────────────────
# "latest" resolves the newest GitHub release at first start; pin exact tags
# for reproducible deploys. Changing a version re-fetches on next `up`.
BACKEND_VERSION=latest
FRONTEND_VERSION=latest

# ── REQUIRED secrets ─────────────────────────────────────────────────────────
# Postgres password (also used by the bundled postgres container).
DB_PASSWORD=

# Platform encryption key: exactly 64 hex chars (256-bit AES). Encrypts the CA
# root key, org data-encryption keys, variables and TOTP secrets. Generate:
#   openssl rand -hex 32
# Set it ONCE before first start and treat it as permanent — it cannot be
# rotated later; losing it orphans all encrypted data. Back it up separately
# from the database.
#PLATFORM_AES_KEY=

# Session-related secret. Generate: openssl rand -base64 48
#JWT_SECRET=

# Bootstrap admin (created on first start against an empty database).
#DEMO_USER_EMAIL=admin@tracedown.dev
#DEMO_USER_PASSWORD=

# ── Deployment ───────────────────────────────────────────────────────────────
# "production" arms the startup guard against placeholder secrets. Leave it.
DEPLOYMENT_ENV=production

# Base URL your users' browsers reach — used to build links in outgoing email.
APP_URL=https://tracedown.example.com

# Public base URL of the metrics scrape endpoint shown in Grafana integrations.
#METRICS_PUBLIC_URL=https://tracedown.example.com

# ── Database ─────────────────────────────────────────────────────────────────
DB_NAME=tracedown
DB_USER=tracedown
# Keep the database name in this URL in sync with DB_NAME.
DATABASE_URL=jdbc:postgresql://tracedown-postgres:5432/tracedown
DATABASE_USER=tracedown
# DATABASE_PASSWORD is derived from DB_PASSWORD by the compose file.
# HikariCP pool size per service (aggregate-worker, metrics-service and
# realtime-service pin 5 connections regardless).
#DB_POOL_SIZE=10

# ── Redis ────────────────────────────────────────────────────────────────────
# One instance serves all three roles by default. Uncomment the extra services
# in docker-compose.yml and repoint B / C here when scaling out.
REDIS_A_URL=redis://tracedown-redis-a:6379
REDIS_B_URL=redis://tracedown-redis-a:6379
# Optional resource-hierarchy cache; empty disables it.
#REDIS_C_URL=redis://tracedown-redis-c:6379
#REDIS_C_TTL_SECONDS=3600

# ── Host-published ports (127.0.0.1 only — your web server proxies to these) ─
#GATEWAY_PORT=20714
#METRICS_PORT=20850
#REALTIME_PORT=20870

# ── Scheduler ────────────────────────────────────────────────────────────────
# Where the scheduler reaches the gateway — and, crucially, the address it hands
# to a probe agent in a health challenge. The agent is told to fetch
# /internal/health/token/{challengeId} from this URL and prove it got the token
# back, so the value has to be reachable BY THE AGENT, not only by the scheduler.
#
# The compose-internal name below is correct only while every agent runs in this
# same compose network. The moment an agent lives anywhere else — another host,
# another network, a different region — it cannot resolve tracedown-gateway,
# every health challenge fails, and the fleet reports itself down. Set this to
# the gateway's PUBLIC base URL in that case
# (https://tracedown.example.com), and make sure your web server proxies
# /internal/health/token/ through to the gateway — nginx.conf and apache.conf in
# this directory already carry that location block, and it exists for exactly
# this reason. Nothing else under /internal/ should be exposed.
GATEWAY_URL=http://tracedown-gateway:20714
#SCHEDULER_SWEEP_INTERVAL=300
#SCHEDULER_THREAD_POOL_SIZE=10
#SCHEDULER_DISPATCH_QUEUE_SIZE=100000
# Global backpressure: concurrent in-flight dispatches. Raising it lets the
# scheduler overwhelm slow targets — add agents instead.
#SCHEDULER_DISPATCH_WORKERS=50
#PROBE_DEFAULT_TIMEOUT_MS=30000
#PROBE_MAX_TIMEOUT_MS=300000
#PROBE_MAX_REDIRECTS=10

# ── Domain trust ─────────────────────────────────────────────────────────────
# false (default): targets must pass domain-ownership verification; unverified
# domains are limited to 3 calls/script, no body saving, 5-minute minimum
# interval. Set true only when every target is infrastructure you own.
# Read by api-gateway, probe-scheduler AND aggregate-worker — keep identical.
#TRUSTED_DOMAIN_MODE=false

# ── Gateway: sessions, auth, rate limiting ───────────────────────────────────
#JWT_TTL_MINUTES=43200
#PASSWORD_MIN_LENGTH=8
#PASSWORD_MIN_UPPERCASE=1
#PASSWORD_MIN_DIGITS=1
#PASSWORD_MIN_SPECIAL=1
#TOTP_ISSUER=Tracedown
#RATE_LIMIT_ENABLED=true
#RATE_LIMIT_GENERAL_MAX=120
#RATE_LIMIT_GENERAL_WINDOW=60
#RATE_LIMIT_AUTH_MAX=15
#RATE_LIMIT_AUTH_WINDOW=60
# Trusted proxy hops when deriving the client IP. 1 = the single host proxy
# in front of the stack (nginx/apache from this directory).
#RATE_LIMIT_TRUSTED_PROXIES=1

# ── Gateway: bootstrap, invites, misc ────────────────────────────────────────
#SINGLE_ORG_MODE=true
#INVITE_TTL_DAYS=7
#INVITE_RESEND_COOLDOWN_MINUTES=5
#ALLOW_PROFILE_EDIT=true
# Let people close their own account from the profile page. Off by default:
# on a managed install accounts are the operator's to remove.
#ALLOW_ACCOUNT_CLOSURE=false
#URI_INVITE=/invite
#URI_PASSWORD_RESET=/reset-password
#SEED_ENABLED=false
#SEED_PROJECT_NAME=Default
#SEED_SERVICE_NAME=httpbin
#SEED_TARGET_URL=https://httpbin.org/get
#SEED_SCHEDULE=*/5 * * * *

# ── Email ────────────────────────────────────────────────────────────────────
# TWO senders with SEPARATE settings: the gateway sends transactional mail
# (invites, resets) via SMTP_* / RESEND_* / MAILGUN_*; the email-service sends
# notification mail via the EMAIL_-prefixed twins. EMAIL_PROVIDER,
# EMAIL_FROM_ADDRESS and EMAIL_FROM_NAME are shared by both. The default
# "console" provider only logs mail — configure a real provider for both.
#EMAIL_PROVIDER=console
#EMAIL_FROM_ADDRESS=notifications@tracedown.example.com
#EMAIL_FROM_NAME=Tracedown

# Gateway (transactional):
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_TLS_MODE=STARTTLS
#RESEND_API_KEY=
#MAILGUN_API_KEY=
#MAILGUN_DOMAIN=
#MAILGUN_REGION=us

# email-service (notifications):
#EMAIL_SMTP_HOST=
#EMAIL_SMTP_PORT=587
#EMAIL_SMTP_USERNAME=
#EMAIL_SMTP_PASSWORD=
#EMAIL_SMTP_TLS_MODE=STARTTLS
#EMAIL_RESEND_API_KEY=
#EMAIL_MAILGUN_API_KEY=
#EMAIL_MAILGUN_DOMAIN=
#EMAIL_MAILGUN_REGION=us

# ── Retention ────────────────────────────────────────────────────────────────
# -1 keeps forever. RESULT_RETENTION_DAYS and AUDIT_LOG_RETENTION_DAYS are
# read by two services each — set once here, it reaches both.
#RESULT_RETENTION_DAYS=90
#HOURLY_AGGREGATE_RETENTION_DAYS=365
#AGENT_HEALTH_RETENTION_DAYS=90
#AUDIT_LOG_RETENTION_DAYS=90
#NOTIFICATION_LOG_RETENTION_DAYS=90
# Days between soft-delete and hard purge (0 = next purge tick).
#PURGE_RETENTION_DAYS=0

# ── Aggregate-worker job intervals (seconds) ─────────────────────────────────
#WORKER_INTERVAL_HOURLY_AGGREGATION=900
#WORKER_INTERVAL_DAILY_AGGREGATION=3600
#WORKER_INTERVAL_RETENTION=3600
#WORKER_INTERVAL_PURGE=300
#WORKER_INTERVAL_SESSION_CLEANUP=900

# ── Notification dispatcher ──────────────────────────────────────────────────
#DISPATCHER_POLL_INTERVAL_MS=5000
#DISPATCHER_BATCH_SIZE=50
#DISPATCHER_STATUS_POP_TIMEOUT=5

# ── Metrics service ──────────────────────────────────────────────────────────
#METRICS_TTL_SECONDS=86400
#METRICS_HOURLY_BUCKET_TTL_SECONDS=90000

# ── email-service queue ──────────────────────────────────────────────────────
#EMAIL_SERVICE_POP_TIMEOUT=5

# ── Body storage (S3-compatible, optional) ───────────────────────────────────
# Saved response bodies default to the shared tracedown-bodies volume. For
# object storage, set the endpoint (its presence is the on/off switch) plus
# credentials — read by result-ingestor (relocation) and aggregate-worker
# (deletion at retention). Agents get their own PROBE_AGENT_S3_* settings.
#STORAGE_S3_ENDPOINT=
#STORAGE_S3_ACCESS_KEY=
#STORAGE_S3_SECRET_KEY=
#STORAGE_S3_BUCKET=
#STORAGE_S3_PREFIX=
# Filesystem root for the ingestor's body relocation — matches the volume
# mount; must equal the agents' PROBE_AGENT_STORAGE_DIR when sharing a volume.
#STORAGE_FILESYSTEM_ROOT=/data/bodies
