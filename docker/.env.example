DB_NAME=tracedown
DB_USER=tracedown
DB_PASSWORD=tracedown
PLATFORM_AES_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=dev-jwt-secret-change-me-for-prod

# Host ports (127.0.0.1) for the gateway, metrics and realtime services.
GATEWAY_PORT=20714
METRICS_PORT=20850
REALTIME_PORT=20870

# Redis URLs (container-internal). Dev runs a single redis-a serving all
# three roles; uncomment the redis-b / redis-c services in
# docker-compose.yml and repoint B and C here when scaling out.
REDIS_A_URL=redis://tracedown-redis-a:6379
REDIS_B_URL=redis://tracedown-redis-a:6379
REDIS_C_URL=redis://tracedown-redis-a:6379
