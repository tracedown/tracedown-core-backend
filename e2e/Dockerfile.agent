# Probe agent for e2e tests.
# Build context is the tracedown/ root so we can access both
# core/probe-agent and lace/ packages.
FROM python:3.13-slim
COPY core/tracedown-probe-agent /opt/agent
COPY lace/lacelang-python-validator /opt/lace-validator
COPY lace/lacelang-python-executor /opt/lace-executor
RUN pip install -q /opt/agent /opt/lace-validator /opt/lace-executor
WORKDIR /opt/agent
ENV PYTHONPATH=/opt/agent/src
EXPOSE 8443
# Run the entrypoint (not `uvicorn main:app`) so the agent bootstraps its
# certificate and serves mutual TLS, matching production.
CMD ["python", "src/main.py"]
